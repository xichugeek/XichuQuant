# Copy to a protected host environment file. Never commit the real file.
MSSQL_SA_PASSWORD=INVALID_EXAMPLE_REPLACE_LOCALLY
XICHURISK_DATABASE_NAME=XichuQuantLocal_local
DATABASE_URL=sqlserver://sqlserver:1433;database=XichuQuantLocal_local;user=sa;password=INVALID_EXAMPLE_REPLACE_LOCALLY;encrypt=true;trustServerCertificate=true
JWT_SECRET=INVALID_EXAMPLE_REPLACE_LOCALLY
BROKER_ACCOUNT_HASH_PEPPER=INVALID_EXAMPLE_REPLACE_LOCALLY
WEB_ORIGIN=https://risk.example.com
SESSION_TTL_HOURS=8
REQUIRE_HTTPS=true
# Exact reverse-proxy / server-renderer IPs only; never use true, hop counts or CIDRs.
TRUSTED_PROXY_IPS=
XICHURISK_DATA_MODE=HISTORICAL
PUBLIC_DEMO_READ_ONLY=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=INVALID_EXAMPLE_REPLACE_LOCALLY
SEED_ADMIN_PASSWORD=INVALID_EXAMPLE_REPLACE_LOCALLY
SEED_DEMO_CONFIRM=
XICHURISK_BACKUP_RETENTION_DAYS=14
XICHURISK_BACKUP_MIN_FREE_GB=10

# Paper execution is deliberately disabled. Enable all three values only after
# the IBKR Paper account hash and gateway have been independently verified.
BROKER_CONNECTOR_MODE=OFFLINE
BROKER_CONNECTOR_ENVIRONMENT=DISABLED
IBKR_PAPER_BASE_URL=
IBKR_PAPER_ACCOUNT_ID=
IBKR_PAPER_TRANSPORT=HTTP
IBKR_TWS_HOST=127.0.0.1
IBKR_TWS_PORT=4002
IBKR_TWS_CLIENT_ID=71
IBKR_TWS_TIMEOUT_MS=12000
IBKR_TWS_API_READ_ONLY=true
IBKR_TWS_EXECUTION_TIMEZONE=
# Optional trusted PEM for the local IBKR Gateway self-signed certificate.
IBKR_GATEWAY_CA_CERT_PATH=
BROKER_PAPER_ACCOUNT_HASH_ALLOWLIST=
