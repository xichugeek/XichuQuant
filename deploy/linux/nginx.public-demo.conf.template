# Only Caddy may supply the visitor address. No private-range or arbitrary XFF trust.
set_real_ip_from ${CADDY_TRUSTED_PROXY_IP};
real_ip_header X-Forwarded-For;
real_ip_recursive off;
geo $realip_remote_addr $from_caddy {
  default 0;
  ${CADDY_TRUSTED_PROXY_IP} 1;
}
limit_req_zone $binary_remote_addr zone=demo_api_rate:1m rate=10r/s;

server {
  listen 8080;
  server_name risk.demo.xichugeek.com;
  server_tokens off;
  client_max_body_size 2m;
  access_log off;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  location = /health { return 200 'ok'; }
  location /api/ {
    if ($from_caddy = 0) { return 403; }
    limit_req zone=demo_api_rate burst=40 nodelay;
    proxy_pass http://api:5089/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;
  }
  location / {
    if ($from_caddy = 0) { return 403; }
    proxy_pass http://web:5088;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
  }
}
