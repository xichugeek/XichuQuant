model PortfolioPerformanceAttribution {
  id                    String   @id @default(uuid())
  portfolioId           String
  portfolioStrategyId   String
  attributionDate       DateTime @db.Date
  strategyReturn        Decimal  @default(0) @db.Decimal(18, 8)
  allocatedContribution Decimal  @default(0) @db.Decimal(18, 8)
  riskContribution      Decimal  @default(0) @db.Decimal(18, 8)
  commissionImpact      Decimal  @default(0) @db.Decimal(20, 4)
  slippageImpact        Decimal  @default(0) @db.Decimal(20, 4)
  riskOpportunityCost   Decimal  @default(0) @db.Decimal(20, 4)
  cashDrag              Decimal  @default(0) @db.Decimal(20, 4)
  detailsJson           String   @db.NVarChar(Max)
  createdAt             DateTime @default(now())

  portfolio         StrategyPortfolio @relation(fields: [portfolioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  portfolioStrategy PortfolioStrategy @relation(fields: [portfolioStrategyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([portfolioId, portfolioStrategyId, attributionDate])
  @@index([portfolioId, attributionDate])
