generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts Account[]
  sessions UserSession[]
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique @db.VarChar(64)
  csrfHash   String    @db.VarChar(64)
  expiresAt  DateTime
  lastSeenAt DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model LoginAttempt {
  id                 String   @id @default(uuid())
  normalizedUsername String   @db.VarChar(120)
  addressHash        String   @db.VarChar(64)
  succeeded          Boolean
  occurredAt         DateTime @default(now())

  @@index([normalizedUsername, addressHash, occurredAt])
}

model Account {
  dataOrigin String @default("UNKNOWN") @db.NVarChar(32)
  id              String   @id @default(uuid())
  userId          String
  name            String
  broker          String?
  brokerAccountId String?
  baseCurrency    String   @default("USD")
  initialCapital  Decimal  @default(0) @db.Decimal(18, 4)
  totalEquity     Decimal  @db.Decimal(18, 4)
  cashBalance     Decimal  @db.Decimal(18, 4)
  realizedPnlYtd  Decimal  @default(0) @db.Decimal(18, 4)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User                    @relation(fields: [userId], references: [id])
  positions       Position[]
  trades          Trade[]
  tradePlans      TradePlan[]
  riskAlerts      RiskAlert[]
  equitySnapshots AccountEquitySnapshot[]
  importBatches   ImportBatch[]
  importRecords   ImportRecord[]
  strategySignals StrategySignal[]

  @@index([userId])
  @@index([broker, brokerAccountId])
}

model AccountEquitySnapshot {
  id             String   @id @default(uuid())
  accountId      String
  snapshotDate   DateTime
  totalEquity    Decimal  @db.Decimal(18, 4)
  cashBalance    Decimal  @db.Decimal(18, 4)
  realizedPnlYtd Decimal  @db.Decimal(18, 4)
  note           String?
  importBatchId  String?
  createdAt      DateTime @default(now())

  account     Account      @relation(fields: [accountId], references: [id])
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([accountId, snapshotDate])
  @@index([accountId, snapshotDate])
  @@index([importBatchId])
}

model Instrument {
  id                 String   @id @default(uuid())
  symbol             String   @unique
  name               String?
  market             String?
  assetType          String
  category           String?
  theme              String?
  underlyingSymbol   String?
  riskTheme          String?
  sector             String?
  industry           String?
  leverageRatio      Decimal? @db.Decimal(8, 2)
  leverageMultiplier Decimal  @default(1) @db.Decimal(8, 4)
  direction          String   @default("LONG")
  leveragedETF       Boolean  @default(false)
  isActive           Boolean  @default(true)
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  positions      Position[]
  trades         Trade[]
  priceSnapshots PriceSnapshot[]
}

model Position {
  id           String   @id @default(uuid())
  accountId    String
  instrumentId String
  quantity     Decimal  @db.Decimal(18, 6)
  avgCost      Decimal  @db.Decimal(18, 4)
  currentPrice Decimal  @db.Decimal(18, 4)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account    Account    @relation(fields: [accountId], references: [id])
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([accountId, instrumentId])
  @@index([accountId])
  @@index([instrumentId])
}

model Trade {
  id             String   @id @default(uuid())
  accountId      String
  instrumentId   String
  tradeDate      DateTime
  side           String
  quantity       Decimal  @db.Decimal(18, 6)
  price          Decimal  @db.Decimal(18, 4)
  commission     Decimal  @default(0) @db.Decimal(18, 4)
  amount         Decimal  @db.Decimal(18, 4)
  realizedPnl    Decimal? @db.Decimal(18, 4)
  reason         String?
  emotionTag     String?
  isRuleFollowed Boolean?
  note           String?
  currency       String   @default("USD")
  externalId     String?
  importBatchId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account     Account      @relation(fields: [accountId], references: [id])
  instrument  Instrument   @relation(fields: [instrumentId], references: [id])
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([accountId])
  @@index([instrumentId])
  @@index([tradeDate])
  @@index([externalId])
  @@index([importBatchId])
}

model ImportBatch {
  id                 String    @id @default(uuid())
  accountId          String
  source             String    @default("IBKR_ACTIVITY_CSV")
  fileName           String
  fileHash           String    @db.VarChar(64)
  status             String    @default("PREVIEW")
  statementAccountId String?
  statementStart     DateTime?
  statementEnd       DateTime?
  totalRecords       Int       @default(0)
  validRecords       Int       @default(0)
  pendingRecords     Int       @default(0)
  duplicateRecords   Int       @default(0)
  importedRecords    Int       @default(0)
  failedRecords      Int       @default(0)
  resultJson         String?   @db.NVarChar(Max)
  rollbackData       String?   @db.NVarChar(Max)
  errorMessage       String?   @db.NVarChar(Max)
  confirmedAt        DateTime?
  rolledBackAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  account         Account                 @relation(fields: [accountId], references: [id])
  records         ImportRecord[]
  trades          Trade[]
  equitySnapshots AccountEquitySnapshot[]

  @@index([accountId, createdAt])
  @@index([fileHash])
  @@index([status])
}

model ImportRecord {
  id                String    @id @default(uuid())
  batchId           String
  accountId         String
  sourceSection     String
  sourceRow         Int
  recordType        String
  status            String    @default("VALID")
  externalId        String    @db.VarChar(128)
  dedupKey          String    @unique @db.VarChar(200)
  externalAccountId String?
  transactionDate   DateTime?
  symbol            String?
  currency          String?
  action            String?
  quantity          Decimal?  @db.Decimal(18, 6)
  price             Decimal?  @db.Decimal(18, 6)
  amount            Decimal?  @db.Decimal(18, 4)
  commission        Decimal?  @db.Decimal(18, 4)
  realizedPnl       Decimal?  @db.Decimal(18, 4)
  rawData           String    @db.NVarChar(Max)
  normalizedData    String    @db.NVarChar(Max)
  validationErrors  String?   @db.NVarChar(Max)
  resolutionNote    String?   @db.NVarChar(Max)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  batch   ImportBatch @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  account Account     @relation(fields: [accountId], references: [id])

  @@index([batchId, status])
  @@index([accountId, externalId])
  @@index([recordType])
}

model TradePlan {
  id                   String   @id @default(uuid())
  accountId            String
  symbol               String
  planType             String
  plannedAmount        Decimal  @db.Decimal(18, 4)
  plannedPrice         Decimal? @db.Decimal(18, 4)
  plannedQuantity      Decimal? @db.Decimal(18, 6)
  reason               String
  maxAcceptableLoss    Decimal? @db.Decimal(18, 4)
  stopLossCondition    String?
  takeProfitCondition  String?
  holdingPeriod        String?
  allowAddPosition     Boolean  @default(false)
  addPositionCondition String?
  status               String   @default("DRAFT")
  reviewResult         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([symbol])
}

model RiskRule {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  ruleType    String
  limitValue  Decimal  @db.Decimal(18, 4)
  level       String
  enabled     Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RiskAlert {
  id              String    @id @default(uuid())
  accountId       String
  ruleCode        String
  level           String
  title           String
  message         String
  symbol          String?
  currentValue    Decimal?  @db.Decimal(18, 4)
  limitValue      Decimal?  @db.Decimal(18, 4)
  suggestedAction String?
  isResolved      Boolean   @default(false)
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, isResolved])
  @@index([ruleCode])
}

model ReviewNote {
  id             String   @id @default(uuid())
  title          String
  symbol         String?
  relatedTradeId String?
  mistakeType    String?
  summary        String
  lesson         String
  actionRule     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([symbol])
}

model PriceSnapshot {
  id           String   @id @default(uuid())
  instrumentId String
  price        Decimal  @db.Decimal(18, 4)
  source       String   @default("MANUAL")
  snapshotTime DateTime @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@index([instrumentId, snapshotTime])
}

// V1.3 行情数据中心。行情数据与真实账户、持仓和交易流水完全隔离。
model MarketDataProvider {
  id                String    @id @default(uuid())
  code              String    @unique
  name              String
  providerType      String
  enabled           Boolean   @default(true)
  configJson        String?   @db.NVarChar(Max)
  providerVersion   String?   @default("1.0")
  rateLimitJson     String?   @db.NVarChar(Max)
  lastHealthStatus  String?
  lastHealthMessage String?   @db.NVarChar(Max)
  lastHealthAt      DateTime?
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  dailyData          MarketDataDaily[]
  importBatches      MarketDataImportBatch[]
  syncJobs           MarketDataSyncJob[]
  dataQualityReports DataQualityReport[]
}

model MarketDataDaily {
  dataOrigin String @default("HISTORICAL") @db.NVarChar(32)
  id            String   @id @default(uuid())
  providerId    String
  symbol        String
  tradeDate     DateTime @db.Date
  open          Decimal  @db.Decimal(20, 6)
  high          Decimal  @db.Decimal(20, 6)
  low           Decimal  @db.Decimal(20, 6)
  close         Decimal  @db.Decimal(20, 6)
  adjustedClose Decimal  @db.Decimal(20, 6)
  volume        Decimal  @default(0) @db.Decimal(24, 4)
  dividend      Decimal  @default(0) @db.Decimal(20, 6)
  splitFactor   Decimal  @default(1) @db.Decimal(18, 8)
  currency      String   @default("USD")
  source        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider MarketDataProvider @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([symbol, tradeDate, source])
  @@index([symbol, tradeDate])
  @@index([providerId, tradeDate])
}

model MarketDataImportBatch {
  id               String    @id @default(uuid())
  providerId       String
  fileName         String
  fileHash         String    @db.VarChar(64)
  status           String    @default("PREVIEW")
  symbol           String?
  startDate        DateTime? @db.Date
  endDate          DateTime? @db.Date
  totalRecords     Int       @default(0)
  validRecords     Int       @default(0)
  pendingRecords   Int       @default(0)
  duplicateRecords Int       @default(0)
  importedRecords  Int       @default(0)
  missingDaysJson  String?   @db.NVarChar(Max)
  mappingJson      String?   @db.NVarChar(Max)
  resultJson       String?   @db.NVarChar(Max)
  errorMessage     String?   @db.NVarChar(Max)
  confirmedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  provider MarketDataProvider       @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  records  MarketDataImportRecord[]

  @@index([providerId, createdAt])
  @@index([fileHash])
  @@index([status])
}

model MarketDataImportRecord {
  id               String    @id @default(uuid())
  batchId          String
  sourceRow        Int
  status           String    @default("VALID")
  symbol           String?
  tradeDate        DateTime? @db.Date
  normalizedData   String    @db.NVarChar(Max)
  rawData          String    @db.NVarChar(Max)
  validationErrors String?   @db.NVarChar(Max)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  batch MarketDataImportBatch @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([batchId, status])
  @@index([symbol, tradeDate])
}

model MarketDataSyncJob {
  id           String    @id @default(uuid())
  providerId   String
  symbol       String?
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  status       String    @default("PENDING")
  requestJson  String?   @db.NVarChar(Max)
  resultJson   String?   @db.NVarChar(Max)
  errorMessage String?   @db.NVarChar(Max)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  provider MarketDataProvider @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([providerId, createdAt])
  @@index([status])
}

model Strategy {
  id                 String   @id @default(uuid())
  name               String
  code               String   @unique
  description        String?
  strategyType       String
  version            Int      @default(1)
  symbolUniverse     String   @db.NVarChar(Max)
  timeframe          String   @default("1D")
  parameters         String   @db.NVarChar(Max)
  parameterSchema    String?  @db.NVarChar(Max)
  initialCapital     Decimal  @db.Decimal(20, 4)
  commissionRate     Decimal  @default(0.001) @db.Decimal(12, 8)
  slippageRate       Decimal  @default(0.0005) @db.Decimal(12, 8)
  positionSizingMode String   @default("PERCENT_OF_EQUITY")
  maxPositionPercent Decimal  @default(100) @db.Decimal(8, 4)
  enabled            Boolean  @default(true)
  approvalStatus     String   @default("DRAFT")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  backtestRuns        BacktestRun[]
  signals             StrategySignal[]
  validationRuns      StrategyValidationRun[]
  parameterSweepRuns  ParameterSweepRun[]
  stressTestRuns      StressTestRun[]
  approvals           StrategyApproval[]
  paperDeployments    StrategyDeployment[]
  portfolioStrategies PortfolioStrategy[]

  @@index([strategyType, enabled])
}

model BacktestRun {
  id                 String    @id @default(uuid())
  strategyId         String
  status             String    @default("PENDING")
  symbol             String
  strategyVersion    Int
  parameterSnapshot  String    @db.NVarChar(Max)
  marketDataSource   String
  marketDataStart    DateTime  @db.Date
  marketDataEnd      DateTime  @db.Date
  initialCapital     Decimal   @db.Decimal(20, 4)
  commissionRate     Decimal   @db.Decimal(12, 8)
  slippageRate       Decimal   @db.Decimal(12, 8)
  randomSeed         Int       @default(42)
  codeVersion        String
  quantEngineVersion String?
  finalEquity        Decimal?  @db.Decimal(20, 4)
  totalReturn        Decimal?  @db.Decimal(18, 8)
  maxDrawdown        Decimal?  @db.Decimal(18, 8)
  sharpeRatio        Decimal?  @db.Decimal(18, 8)
  benchmarkReturn    Decimal?  @db.Decimal(18, 8)
  totalCommission    Decimal?  @db.Decimal(20, 4)
  tradeCount         Int?
  metricsJson        String?   @db.NVarChar(Max)
  monthlyReturnsJson String?   @db.NVarChar(Max)
  riskNotice         String?   @db.NVarChar(Max)
  errorMessage       String?   @db.NVarChar(Max)
  runDurationMs      Int?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  strategy     Strategy              @relation(fields: [strategyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  equityPoints BacktestEquityPoint[]
  trades       BacktestTrade[]
  positions    BacktestPosition[]
  signals      StrategySignal[]

  @@index([strategyId, createdAt])
  @@index([status])
  @@index([symbol, marketDataStart, marketDataEnd])
}

model BacktestEquityPoint {
  id              String   @id @default(uuid())
  backtestRunId   String
  tradeDate       DateTime @db.Date
  equity          Decimal  @db.Decimal(20, 4)
  cash            Decimal  @db.Decimal(20, 4)
  positionValue   Decimal  @db.Decimal(20, 4)
  drawdown        Decimal  @db.Decimal(18, 8)
  benchmarkEquity Decimal  @db.Decimal(20, 4)
  createdAt       DateTime @default(now())

  backtestRun BacktestRun @relation(fields: [backtestRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([backtestRunId, tradeDate])
  @@index([backtestRunId, tradeDate])
}

model BacktestTrade {
  id             String   @id @default(uuid())
  backtestRunId  String
  symbol         String
  side           String
  signalTime     DateTime
  orderTime      DateTime
  executionTime  DateTime
  executionPrice Decimal  @db.Decimal(20, 6)
  quantity       Decimal  @db.Decimal(20, 8)
  notional       Decimal  @db.Decimal(20, 4)
  commission     Decimal  @db.Decimal(20, 4)
  slippage       Decimal  @db.Decimal(20, 4)
  realizedPnl    Decimal? @db.Decimal(20, 4)
  holdingDays    Int?
  triggerReason  String
  createdAt      DateTime @default(now())

  backtestRun BacktestRun @relation(fields: [backtestRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([backtestRunId, executionTime])
  @@index([symbol, executionTime])
}

model BacktestPosition {
  id            String   @id @default(uuid())
  backtestRunId String
  symbol        String
  quantity      Decimal  @db.Decimal(20, 8)
  avgCost       Decimal  @db.Decimal(20, 6)
  lastPrice     Decimal  @db.Decimal(20, 6)
  marketValue   Decimal  @db.Decimal(20, 4)
  unrealizedPnl Decimal  @db.Decimal(20, 4)
  createdAt     DateTime @default(now())

  backtestRun BacktestRun @relation(fields: [backtestRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([backtestRunId, symbol])
  @@index([backtestRunId])
}

model StrategySignal {
  id                String    @id @default(uuid())
  strategyId        String
  backtestRunId     String?
  accountId         String?
  paperAccountId    String?
  signalContext     String    @default("REAL_ACCOUNT")
  symbol            String
  signalType        String
  signalTime        DateTime
  requestedAmount   Decimal?  @db.Decimal(20, 4)
  requestedQuantity Decimal?  @db.Decimal(20, 8)
  referencePrice    Decimal?  @db.Decimal(20, 6)
  stopLossCondition String?
  exitCondition     String?
  status            String    @default("GENERATED")
  triggerReason     String
  riskResultJson    String?   @db.NVarChar(Max)
  rejectionReason   String?   @db.NVarChar(Max)
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  strategy               Strategy                @relation(fields: [strategyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  backtestRun            BacktestRun?            @relation(fields: [backtestRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  account                Account?                @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  portfolioSignalIntents PortfolioSignalIntent[]

  @@index([strategyId, createdAt])
  @@index([backtestRunId, signalTime])
  @@index([accountId, status])
  @@index([paperAccountId, status])
  @@index([symbol, signalTime])
}

// V1.4 策略稳健性验证。所有输入、输出和审批结论均保留快照，禁止覆盖历史结果。
model StrategyValidationRun {
  id                     String    @id @default(uuid())
  strategyId             String
  status                 String    @default("PENDING")
  symbolsJson            String    @db.NVarChar(Max)
  marketDataSource       String
  marketDataStart        DateTime  @db.Date
  marketDataEnd          DateTime  @db.Date
  inSampleRatio          Decimal   @default(0.7) @db.Decimal(8, 6)
  walkForwardConfigJson  String    @db.NVarChar(Max)
  parameterGridJson      String    @db.NVarChar(Max)
  stressConfigJson       String    @db.NVarChar(Max)
  parameterSnapshot      String    @db.NVarChar(Max)
  randomSeed             Int       @default(42)
  codeVersion            String
  quantEngineVersion     String?
  inSampleMetricsJson    String?   @db.NVarChar(Max)
  outSampleMetricsJson   String?   @db.NVarChar(Max)
  regimeMetricsJson      String?   @db.NVarChar(Max)
  crossSymbolMetricsJson String?   @db.NVarChar(Max)
  warningsJson           String?   @db.NVarChar(Max)
  robustnessScore        Decimal?  @db.Decimal(18, 8)
  recommendation         String?
  errorMessage           String?   @db.NVarChar(Max)
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  strategy        Strategy            @relation(fields: [strategyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  windows         ValidationWindow[]
  parameterSweeps ParameterSweepRun[]
  stressTests     StressTestRun[]
  approvals       StrategyApproval[]

  @@index([strategyId, createdAt])
  @@index([status])
}

model ValidationWindow {
  id                String   @id @default(uuid())
  validationRunId   String
  sequence          Int
  windowType        String
  trainStart        DateTime @db.Date
  trainEnd          DateTime @db.Date
  testStart         DateTime @db.Date
  testEnd           DateTime @db.Date
  parameterSnapshot String   @db.NVarChar(Max)
  trainMetricsJson  String?  @db.NVarChar(Max)
  testMetricsJson   String   @db.NVarChar(Max)
  testEquityJson    String?  @db.NVarChar(Max)
  testTradesJson    String?  @db.NVarChar(Max)
  totalReturn       Decimal? @db.Decimal(18, 8)
  maxDrawdown       Decimal? @db.Decimal(18, 8)
  sharpeRatio       Decimal? @db.Decimal(18, 8)
  profitFactor      Decimal? @db.Decimal(18, 8)
  tradeCount        Int      @default(0)
  createdAt         DateTime @default(now())

  validationRun StrategyValidationRun @relation(fields: [validationRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([validationRunId, sequence, windowType])
  @@index([validationRunId, testStart])
}

model ParameterSweepRun {
  id                   String    @id @default(uuid())
  validationRunId      String
  strategyId           String
  status               String    @default("PENDING")
  dimensionsJson       String    @db.NVarChar(Max)
  objectiveMetric      String    @default("ROBUSTNESS")
  stabilitySummaryJson String?   @db.NVarChar(Max)
  errorMessage         String?   @db.NVarChar(Max)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  validationRun StrategyValidationRun  @relation(fields: [validationRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  strategy      Strategy               @relation(fields: [strategyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  results       ParameterSweepResult[]

  @@index([validationRunId, status])
  @@index([strategyId, createdAt])
}

model ParameterSweepResult {
  id             String   @id @default(uuid())
  sweepRunId     String
  parameterKey   String   @db.VarChar(200)
  parametersJson String   @db.NVarChar(Max)
  totalReturn    Decimal  @db.Decimal(18, 8)
  maxDrawdown    Decimal  @db.Decimal(18, 8)
  sharpeRatio    Decimal? @db.Decimal(18, 8)
  profitFactor   Decimal? @db.Decimal(18, 8)
  tradeCount     Int
  stabilityScore Decimal? @db.Decimal(18, 8)
  flagsJson      String?  @db.NVarChar(Max)
  createdAt      DateTime @default(now())

  sweepRun ParameterSweepRun @relation(fields: [sweepRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([sweepRunId, parameterKey])
  @@index([sweepRunId, stabilityScore])
}

model StressTestRun {
  id                  String    @id @default(uuid())
  validationRunId     String
  strategyId          String
  status              String    @default("PENDING")
  baselineMetricsJson String?   @db.NVarChar(Max)
  summaryJson         String?   @db.NVarChar(Max)
  errorMessage        String?   @db.NVarChar(Max)
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  validationRun StrategyValidationRun @relation(fields: [validationRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  strategy      Strategy              @relation(fields: [strategyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  results       StressTestResult[]

  @@index([validationRunId, status])
  @@index([strategyId, createdAt])
}

model StressTestResult {
  id                 String   @id @default(uuid())
  stressTestRunId    String
  scenarioCode       String
  scenarioConfigJson String   @db.NVarChar(Max)
  metricsJson        String   @db.NVarChar(Max)
  totalReturn        Decimal  @db.Decimal(18, 8)
  maxDrawdown        Decimal  @db.Decimal(18, 8)
  returnDegradation  Decimal  @db.Decimal(18, 8)
  tradeCount         Int
  failed             Boolean  @default(false)
  createdAt          DateTime @default(now())

  stressTestRun StressTestRun @relation(fields: [stressTestRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([stressTestRunId, scenarioCode])
  @@index([stressTestRunId, failed])
}

model StrategyApproval {
  id              String    @id @default(uuid())
  strategyId      String
  validationRunId String
  decisionVersion Int       @default(1)
  status          String
  userConfirmed   Boolean   @default(false)
  criteriaJson    String    @db.NVarChar(Max)
  reasonsJson     String    @db.NVarChar(Max)
  riskResultJson  String?   @db.NVarChar(Max)
  requestedAt     DateTime  @default(now())
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())

  strategy      Strategy              @relation(fields: [strategyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  validationRun StrategyValidationRun @relation(fields: [validationRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([validationRunId, decisionVersion])
  @@index([strategyId, status])
}

// V1.4 模拟交易账本。Paper* 模型不得与真实 Account/Position/Trade 混用。
model PaperAccount {
  dataOrigin String @default("INTERNAL_PAPER") @db.NVarChar(32)
  id                String   @id @default(uuid())
  name              String
  baseCurrency      String   @default("USD")
  initialCapital    Decimal  @db.Decimal(20, 4)
  cashBalance       Decimal  @db.Decimal(20, 4)
  totalEquity       Decimal  @db.Decimal(20, 4)
  realizedPnl       Decimal  @default(0) @db.Decimal(20, 4)
  unrealizedPnl     Decimal  @default(0) @db.Decimal(20, 4)
  peakEquity        Decimal  @db.Decimal(20, 4)
  maxDrawdown       Decimal  @default(0) @db.Decimal(18, 8)
  status            String   @default("ACTIVE")
  killSwitchEnabled Boolean  @default(false)
  killSwitchReason  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  snapshots     PaperAccountEquitySnapshot[]
  positions     PaperPosition[]
  orders        PaperOrder[]
  cashMovements PaperCashMovement[]
  deployments   StrategyDeployment[]
  events        PaperTradingEvent[]

  @@index([status])
}

model PaperAccountEquitySnapshot {
  id             String   @id @default(uuid())
  paperAccountId String
  snapshotTime   DateTime
  totalEquity    Decimal  @db.Decimal(20, 4)
  cashBalance    Decimal  @db.Decimal(20, 4)
  positionValue  Decimal  @db.Decimal(20, 4)
  realizedPnl    Decimal  @db.Decimal(20, 4)
  unrealizedPnl  Decimal  @db.Decimal(20, 4)
  drawdown       Decimal  @db.Decimal(18, 8)
  source         String   @default("PAPER_EXECUTION")
  createdAt      DateTime @default(now())

  paperAccount PaperAccount @relation(fields: [paperAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([paperAccountId, snapshotTime])
  @@index([paperAccountId, snapshotTime])
}

model PaperPosition {
  id                   String   @id @default(uuid())
  paperAccountId       String
  strategyDeploymentId String
  symbol               String
  quantity             Decimal  @db.Decimal(20, 8)
  avgCost              Decimal  @db.Decimal(20, 6)
  currentPrice         Decimal  @db.Decimal(20, 6)
  marketValue          Decimal  @db.Decimal(20, 4)
  unrealizedPnl        Decimal  @db.Decimal(20, 4)
  realizedPnl          Decimal  @default(0) @db.Decimal(20, 4)
  openedAt             DateTime
  updatedAt            DateTime @updatedAt

  paperAccount PaperAccount       @relation(fields: [paperAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deployment   StrategyDeployment @relation(fields: [strategyDeploymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([paperAccountId, strategyDeploymentId, symbol])
  @@index([paperAccountId, symbol])
  @@index([strategyDeploymentId])
}

model PaperOrder {
  id                   String    @id @default(uuid())
  paperAccountId       String
  strategyDeploymentId String
  executionRunId       String
  strategySignalId     String?
  idempotencyKey       String    @unique @db.VarChar(200)
  symbol               String
  side                 String
  signalTradeDate      DateTime  @db.Date
  earliestFillDate     DateTime? @db.Date
  requestedAmount      Decimal?  @db.Decimal(20, 4)
  requestedQuantity    Decimal?  @db.Decimal(20, 8)
  approvedQuantity     Decimal?  @db.Decimal(20, 8)
  referencePrice       Decimal?  @db.Decimal(20, 6)
  commissionRate       Decimal   @db.Decimal(12, 8)
  slippageRate         Decimal   @db.Decimal(12, 8)
  status               String    @default("CREATED")
  rejectionReason      String?   @db.NVarChar(Max)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  filledAt             DateTime?
  cancelledAt          DateTime?

  paperAccount  PaperAccount         @relation(fields: [paperAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deployment    StrategyDeployment   @relation(fields: [strategyDeploymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  executionRun  StrategyExecutionRun @relation(fields: [executionRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fills         PaperFill[]
  riskDecisions PaperRiskDecision[]
  events        PaperTradingEvent[]

  @@index([paperAccountId, status])
  @@index([strategyDeploymentId, signalTradeDate])
}

model PaperFill {
  id            String   @id @default(uuid())
  paperOrderId  String
  fillSequence  Int      @default(1)
  executionTime DateTime
  price         Decimal  @db.Decimal(20, 6)
  quantity      Decimal  @db.Decimal(20, 8)
  notional      Decimal  @db.Decimal(20, 4)
  commission    Decimal  @db.Decimal(20, 4)
  slippage      Decimal  @db.Decimal(20, 4)
  realizedPnl   Decimal? @db.Decimal(20, 4)
  createdAt     DateTime @default(now())

  paperOrder PaperOrder          @relation(fields: [paperOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events     PaperTradingEvent[]

  @@unique([paperOrderId, fillSequence])
  @@index([executionTime])
}

model PaperCashMovement {
  id             String   @id @default(uuid())
  paperAccountId String
  paperOrderId   String?
  movementType   String
  amount         Decimal  @db.Decimal(20, 4)
  balanceAfter   Decimal  @db.Decimal(20, 4)
  description    String?
  eventTime      DateTime
  createdAt      DateTime @default(now())

  paperAccount PaperAccount @relation(fields: [paperAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([paperAccountId, eventTime])
  @@index([paperOrderId])
}

model StrategyDeployment {
  id                      String    @id @default(uuid())
  strategyId              String
  paperAccountId          String
  approvalId              String
  name                    String
  status                  String    @default("PAPER_APPROVED")
  symbolUniverseJson      String    @db.NVarChar(Max)
  parameterSnapshot       String    @db.NVarChar(Max)
  strategyVersion         Int
  codeVersion             String
  capitalAllocation       Decimal   @db.Decimal(20, 4)
  maxPositionPercent      Decimal   @db.Decimal(8, 4)
  stopLossCondition       String
  exitCondition           String
  paperRiskConfigJson     String    @db.NVarChar(Max)
  consecutiveLosses       Int       @default(0)
  observationStartedAt    DateTime?
  observationRequiredDays Int       @default(20)
  startedAt               DateTime?
  pausedAt                DateTime?
  stoppedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  strategy            Strategy                     @relation(fields: [strategyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paperAccount        PaperAccount                 @relation(fields: [paperAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  positions           PaperPosition[]
  orders              PaperOrder[]
  executionRuns       StrategyExecutionRun[]
  riskDecisions       PaperRiskDecision[]
  events              PaperTradingEvent[]
  forwardObservations ForwardObservationSnapshot[]
  portfolioStrategies PortfolioStrategy[]

  @@index([paperAccountId, status])
  @@index([strategyId, createdAt])
  @@index([approvalId])
}

model StrategyExecutionRun {
  id                   String    @id @default(uuid())
  strategyDeploymentId String
  symbol               String
  signalTradeDate      DateTime  @db.Date
  idempotencyKey       String    @unique @db.VarChar(200)
  strategyVersion      Int
  status               String    @default("PENDING")
  strategySignalId     String?
  inputSnapshotJson    String    @db.NVarChar(Max)
  resultJson           String?   @db.NVarChar(Max)
  quantEngineVersion   String?
  errorMessage         String?   @db.NVarChar(Max)
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  createdAt            DateTime  @default(now())

  deployment StrategyDeployment @relation(fields: [strategyDeploymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders     PaperOrder[]

  @@unique([strategyDeploymentId, symbol, signalTradeDate, strategyVersion])
  @@index([strategyDeploymentId, createdAt])
}

model PaperRiskDecision {
  id                   String   @id @default(uuid())
  strategyDeploymentId String
  paperOrderId         String?
  strategySignalId     String?
  decision             String
  inputSnapshotJson    String   @db.NVarChar(Max)
  resultJson           String   @db.NVarChar(Max)
  violationsJson       String   @db.NVarChar(Max)
  engineVersion        String
  createdAt            DateTime @default(now())

  deployment StrategyDeployment @relation(fields: [strategyDeploymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paperOrder PaperOrder?        @relation(fields: [paperOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([strategyDeploymentId, createdAt])
  @@index([paperOrderId])
}

model PaperTradingEvent {
  id                   String   @id @default(uuid())
  paperAccountId       String
  strategyDeploymentId String?
  paperOrderId         String?
  paperFillId          String?
  eventType            String
  severity             String   @default("INFO")
  payloadJson          String   @db.NVarChar(Max)
  createdAt            DateTime @default(now())

  paperAccount PaperAccount        @relation(fields: [paperAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deployment   StrategyDeployment? @relation(fields: [strategyDeploymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paperOrder   PaperOrder?         @relation(fields: [paperOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paperFill    PaperFill?          @relation(fields: [paperFillId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([paperAccountId, createdAt])
  @@index([strategyDeploymentId, createdAt])
  @@index([eventType])
}

model PaperTradingControl {
  id                String   @id @default("global")
  killSwitchEnabled Boolean  @default(false)
  reason            String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// V1.5 美国市场交易日历。所有调度均使用 America/New_York，不使用服务器本地日期。
model TradingCalendarDay {
  id              String    @id @default(uuid())
  market          String    @default("US")
  tradeDate       DateTime  @db.Date
  isTradingDay    Boolean
  sessionOpenUtc  DateTime?
  sessionCloseUtc DateTime?
  holidayName     String?
  timeZone        String    @default("America/New_York")
  source          String    @default("SYSTEM_NYSE_RULES")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([market, tradeDate])
  @@index([market, isTradingDay, tradeDate])
}

model DataQualityReport {
  id                 String    @id @default(uuid())
  providerId         String
  symbol             String
  analysisDate       DateTime  @db.Date
  latestTradeDate    DateTime? @db.Date
  missingDayCount    Int       @default(0)
  duplicateCount     Int       @default(0)
  invalidOhlcCount   Int       @default(0)
  zeroVolumeCount    Int       @default(0)
  splitEventCount    Int       @default(0)
  dividendEventCount Int       @default(0)
  allowStrategyRun   Boolean   @default(false)
  status             String    @default("PENDING")
  issuesJson         String    @db.NVarChar(Max)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  provider MarketDataProvider @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([providerId, symbol, analysisDate])
  @@index([symbol, analysisDate])
  @@index([allowStrategyRun, status])
}

// 统一任务表覆盖行情同步、策略运行、撮合、权益快照和风控重算。
model SystemTask {
  id             String    @id @default(uuid())
  parentTaskId   String?
  taskType       String
  idempotencyKey String    @unique @db.VarChar(240)
  status         String    @default("PENDING")
  marketDate     DateTime? @db.Date
  scheduledFor   DateTime?
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(3)
  inputJson      String?   @db.NVarChar(Max)
  resultJson     String?   @db.NVarChar(Max)
  errorMessage   String?   @db.NVarChar(Max)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([taskType, status, createdAt])
  @@index([marketDate, taskType])
  @@index([parentTaskId])
}

model SystemNotification {
  id           String    @id @default(uuid())
  type         String
  severity     String    @default("INFO")
  title        String
  message      String    @db.NVarChar(Max)
  status       String    @default("UNREAD")
  sourceTaskId String?
  metadataJson String?   @db.NVarChar(Max)
  dedupeKey    String?   @unique @db.VarChar(240)
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, severity, createdAt])
  @@index([type, createdAt])
}

model ForwardObservationSnapshot {
  id                   String   @id @default(uuid())
  strategyDeploymentId String
  observationDate      DateTime @db.Date
  runningTradingDays   Int      @default(0)
  signalCount          Int      @default(0)
  fillCount            Int      @default(0)
  actualReturn         Decimal  @default(0) @db.Decimal(18, 8)
  theoreticalReturn    Decimal  @default(0) @db.Decimal(18, 8)
  returnDeviation      Decimal  @default(0) @db.Decimal(18, 8)
  actualSlippage       Decimal  @default(0) @db.Decimal(20, 4)
  totalCommission      Decimal  @default(0) @db.Decimal(20, 4)
  maxDrawdown          Decimal  @default(0) @db.Decimal(18, 8)
  consecutiveLosses    Int      @default(0)
  riskRejectedCount    Int      @default(0)
  dataSkippedCount     Int      @default(0)
  serviceSkippedCount  Int      @default(0)
  comparisonJson       String   @db.NVarChar(Max)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  deployment StrategyDeployment @relation(fields: [strategyDeploymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([strategyDeploymentId, observationDate])
  @@index([strategyDeploymentId, observationDate])
}

// V1.6 组合账本。Portfolio* 模型只用于模拟组合，不得与真实 Account/Position/Trade 混用。
model StrategyPortfolio {
  id                 String    @id @default(uuid())
  name               String
  description        String?   @db.NVarChar(Max)
  baseCurrency       String    @default("USD")
  initialCapital     Decimal   @db.Decimal(20, 4)
  cashBalance        Decimal   @db.Decimal(20, 4)
  totalEquity        Decimal   @db.Decimal(20, 4)
  realizedPnl        Decimal   @default(0) @db.Decimal(20, 4)
  unrealizedPnl      Decimal   @default(0) @db.Decimal(20, 4)
  peakEquity         Decimal   @db.Decimal(20, 4)
  maxDrawdown        Decimal   @default(0) @db.Decimal(18, 8)
  cashReservePercent Decimal   @db.Decimal(8, 4)
  allocationMode     String
  rebalanceMode      String
  conflictPolicy     String    @default("NETTING")
  status             String    @default("DRAFT")
  noNewPositions     Boolean   @default(false)
  readOnlyMode       Boolean   @default(false)
  pausedAt           DateTime?
  stoppedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  strategies      PortfolioStrategy[]
  allocationRules PortfolioAllocationRule[]
  riskRules       PortfolioRiskRule[]
  snapshots       PortfolioEquitySnapshot[]
  rebalanceRuns   PortfolioRebalanceRun[]
  attributions    PortfolioPerformanceAttribution[]
  signalIntents   PortfolioSignalIntent[]
  positions       PortfolioPosition[]
  orders          PortfolioOrder[]
  cashMovements   PortfolioCashMovement[]
  auditEvents     PortfolioAuditEvent[]

  @@index([status, createdAt])
}

model PortfolioStrategy {
  id                      String   @id @default(uuid())
  portfolioId             String
  strategyId              String
  strategyDeploymentId    String?
  priority                Int      @default(100)
  targetAllocationPercent Decimal  @default(0) @db.Decimal(8, 4)
  manualAmount            Decimal? @db.Decimal(20, 4)
  maxCapitalPercent       Decimal  @db.Decimal(8, 4)
  virtualCapital          Decimal  @default(0) @db.Decimal(20, 4)
  virtualCash             Decimal  @default(0) @db.Decimal(20, 4)
  realizedPnl             Decimal  @default(0) @db.Decimal(20, 4)
  status                  String   @default("ACTIVE")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  portfolio        StrategyPortfolio                 @relation(fields: [portfolioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  strategy         Strategy                          @relation(fields: [strategyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deployment       StrategyDeployment?               @relation(fields: [strategyDeploymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  positions        PortfolioStrategyPosition[]
  signalIntents    PortfolioSignalIntent[]
  orderAllocations PortfolioOrderAllocation[]
  fillAllocations  PortfolioFillAllocation[]
  attributions     PortfolioPerformanceAttribution[]
  cashMovements    PortfolioCashMovement[]
  auditEvents      PortfolioAuditEvent[]

  @@unique([portfolioId, strategyId])
  @@index([portfolioId, status, priority])
  @@index([strategyDeploymentId])
}

// 分配和风控规则按 version 追加，不覆盖历史参数。
model PortfolioAllocationRule {
  id                String   @id @default(uuid())
  portfolioId       String
  version           Int
  allocationMode    String
  configurationJson String   @db.NVarChar(Max)
  effectiveFrom     DateTime @default(now())
  createdAt         DateTime @default(now())

  portfolio StrategyPortfolio @relation(fields: [portfolioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([portfolioId, version])
  @@index([portfolioId, effectiveFrom])
}

model PortfolioRiskRule {
  id                                     String   @id @default(uuid())
  portfolioId                            String
  version                                Int
  singleStrategyMaxPercent               Decimal  @default(40) @db.Decimal(8, 4)
  singleSymbolMaxPercent                 Decimal  @default(30) @db.Decimal(8, 4)
  singleThemeMaxPercent                  Decimal  @default(40) @db.Decimal(8, 4)
  leveragedEtfMaxPercent                 Decimal  @default(10) @db.Decimal(8, 4)
  leveragedStrategyMaxPercent            Decimal  @default(20) @db.Decimal(8, 4)
  correlatedStrategiesMaxPercent         Decimal  @default(50) @db.Decimal(8, 4)
  correlationThreshold                   Decimal  @default(0.8) @db.Decimal(8, 6)
  maxConcurrentPositions                 Int      @default(10)
  minCashPercent                         Decimal  @default(20) @db.Decimal(8, 4)
  maxDailyLossPercent                    Decimal  @default(3) @db.Decimal(8, 4)
  maxDrawdownPercent                     Decimal  @default(15) @db.Decimal(8, 4)
  maxLosingStrategies                    Int      @default(2)
  maxStrategyDrawdownContributionPercent Decimal  @default(50) @db.Decimal(8, 4)
  createdAt                              DateTime @default(now())

  portfolio StrategyPortfolio @relation(fields: [portfolioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([portfolioId, version])
  @@index([portfolioId, createdAt])
}

model PortfolioEquitySnapshot {
  id              String   @id @default(uuid())
  portfolioId     String
  snapshotDate    DateTime @db.Date
  totalEquity     Decimal  @db.Decimal(20, 4)
  cashBalance     Decimal  @db.Decimal(20, 4)
  positionValue   Decimal  @db.Decimal(20, 4)
  realizedPnl     Decimal  @db.Decimal(20, 4)
  unrealizedPnl   Decimal  @db.Decimal(20, 4)
  totalReturn     Decimal  @db.Decimal(18, 8)
  dailyReturn     Decimal  @default(0) @db.Decimal(18, 8)
  drawdown        Decimal  @db.Decimal(18, 8)
  benchmarkEquity Decimal? @db.Decimal(20, 4)
  exposureJson    String   @db.NVarChar(Max)
  createdAt       DateTime @default(now())

  portfolio StrategyPortfolio @relation(fields: [portfolioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([portfolioId, snapshotDate])
  @@index([portfolioId, snapshotDate])
}

model PortfolioRebalanceRun {
  id                   String    @id @default(uuid())
  portfolioId          String
  tradeDate            DateTime  @db.Date
  idempotencyKey       String    @unique @db.VarChar(240)
  runType              String
  status               String    @default("PREVIEWED")
  allocationVersion    Int
  riskVersion          Int
  conflictPolicy       String
  beforeAllocationJson String    @db.NVarChar(Max)
  afterAllocationJson  String    @db.NVarChar(Max)
  rawSignalsJson       String    @db.NVarChar(Max)
  netIntentsJson       String    @db.NVarChar(Max)
  estimatedOrdersJson  String    @db.NVarChar(Max)
  riskResultJson       String    @db.NVarChar(Max)
  estimatedCommission  Decimal   @default(0) @db.Decimal(20, 4)
  estimatedCash        Decimal   @db.Decimal(20, 4)
  previewOnly          Boolean   @default(true)
  errorMessage         String?   @db.NVarChar(Max)
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

