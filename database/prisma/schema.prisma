model PortfolioSignalIntent {
  id                  String   @id @default(uuid())
  portfolioId         String
  portfolioStrategyId String
  rebalanceRunId      String
  strategySignalId    String?
  idempotencyKey      String   @unique @db.VarChar(240)
  tradeDate           DateTime @db.Date
  symbol              String
  side                String
  originalQuantity    Decimal? @db.Decimal(20, 8)
  originalAmount      Decimal? @db.Decimal(20, 4)
  approvedQuantity    Decimal? @db.Decimal(20, 8)
  allocatedAmount     Decimal? @db.Decimal(20, 4)
  status              String   @default("PENDING")
  reason              String?  @db.NVarChar(Max)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

