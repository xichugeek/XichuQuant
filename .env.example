JWT_SECRET="INVALID_EXAMPLE_REPLACE_LOCALLY"
SEED_ADMIN_PASSWORD="INVALID_EXAMPLE_REPLACE_LOCALLY"
JWT_EXPIRES_IN="7d"
WEB_PORT=5088
API_PORT=5089
QUANT_ENGINE_URL="http://localhost:5091"
QUANT_ENGINE_TIMEOUT_MS=120000
BROKER_CONNECTOR_URL="http://localhost:5092"
BROKER_CONNECTOR_PORT=5092
BROKER_CONNECTOR_MODE="OFFLINE"
IBKR_READONLY_BASE_URL=""
BROKER_CONNECTOR_ENVIRONMENT="DISABLED"
IBKR_PAPER_BASE_URL=""
IBKR_PAPER_ACCOUNT_ID=""
IBKR_PAPER_TRANSPORT="HTTP"
# TWS / IB Gateway Socket Paper：本机直跑使用 127.0.0.1；容器访问宿主机使用 host.docker.internal。
IBKR_TWS_HOST="127.0.0.1"
IBKR_TWS_PORT=4002
IBKR_TWS_CLIENT_ID=71
IBKR_TWS_TIMEOUT_MS=12000
# 首次联调必须保持 true；完成 Paper 验收后仍需经过系统审批链才能改为 false。
IBKR_TWS_API_READ_ONLY=true
# 可选：IBKR Gateway 自签证书对应的可信 PEM；不得关闭 TLS 证书校验。
IBKR_GATEWAY_CA_CERT_PATH=""
BROKER_PAPER_ACCOUNT_HASH_ALLOWLIST=""
BROKER_ACCOUNT_HASH_PEPPER="INVALID_EXAMPLE_REPLACE_LOCALLY"
MARKET_DATA_HTTP_BASE_URL=""
MARKET_DATA_HTTP_API_KEY=""
SEC_USER_AGENT="XichuQuant local-research contact@example.com"
FRED_API_KEY=""
WEB_ORIGIN="http://localhost:5088"
SESSION_TTL_HOURS=8
REQUIRE_HTTPS=false
XICHURISK_BACKUP_RETENTION_DAYS=14
XICHURISK_BACKUP_MIN_FREE_GB=10
NODE_ENV=development
API_HOST=127.0.0.1
BROKER_CONNECTOR_HOST=127.0.0.1
PUBLIC_DEMO_READ_ONLY=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD="INVALID_EXAMPLE_REPLACE_LOCALLY"

# Demo Seed is opt-in and refuses all business databases. Example dedicated name: XichuQuantDemo_local
SEED_DEMO_CONFIRM=""
XICHURISK_DATA_MODE="HISTORICAL"
# Required for zoneless TWS execution times; must match the Gateway login timezone.
IBKR_TWS_EXECUTION_TIMEZONE=""
# Link broker reads to an explicitly selected local account; never guess the first account.
BROKER_LOCAL_ACCOUNT_ID=""
